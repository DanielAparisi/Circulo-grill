---
import Button from '../ui/Button.astro';
import SelloCirculo from '../ui/SelloCirculo.astro';
import { locations } from '../../data/locations';

const castillas = locations[0];
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="container hero__grid">
    <div class="hero__texto">
      <p class="antetitulo">Bar y parrilla · Las Castillas y Meco</p>

      <h1 id="hero-titulo" class="hero__titulo">
        La parrilla <span class="hero__titulo-linea">de Las Castillas</span>
      </h1>

      <span class="filete" aria-hidden="true"></span>

      <p class="hero__entradilla">
        Hamburguesas al carbón, costillar de seis horas y entrantes para el centro de la mesa.
        Vienes, te lo llevas o te lo llevamos.
      </p>

      <div class="hero__acciones">
        <Button href="#carta" variant="primary" size="lg">Ver la carta</Button>
        <Button href={`tel:${castillas.primaryPhone.tel}`} variant="secondary" size="lg">
          <svg slot="icon-start" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar a Las Castillas
        </Button>
      </div>
    </div>

    <div class="hero__sello">
      <SelloCirculo />
    </div>
  </div>

  <!-- Lo que se busca desde el móvil: dónde, cuándo y qué opinan -->
  <div class="container">
    <dl class="hero__datos">
      <div class="hero__dato">
        <dt class="etiqueta">Dónde</dt>
        <dd>
          <a href={castillas.mapsUrl} target="_blank" rel="noopener noreferrer">{castillas.address}</a>
          <span>{castillas.city}</span>
        </dd>
      </div>
      <div class="hero__dato">
        <dt class="etiqueta">Cuándo</dt>
        <dd>
          {castillas.hours.details[0].days}
          <span>{castillas.hours.details[0].hours}</span>
        </dd>
      </div>
      {castillas.rating && (
        <div class="hero__dato">
          <dt class="etiqueta">Qué dicen</dt>
          <dd>
            {castillas.rating.score.toLocaleString('es-ES')} de 5 en Google
            <span>{castillas.rating.reviewsCount} reseñas</span>
          </dd>
        </div>
      )}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 0.5rem + 4vw, 5rem);
    padding-bottom: var(--espacio-6);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: var(--espacio-7);
    align-items: center;
  }

  @media (min-width: 880px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--espacio-8);
    }
  }

  .hero__titulo {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    color: var(--texto);
    margin: 0;
    text-wrap: balance;
  }

  .hero__titulo-linea {
    display: block;
    color: var(--texto-ambar);
  }

  .hero__entradilla {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.6;
    color: var(--texto-suave);
    max-width: 46ch;
    margin-bottom: var(--espacio-6);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-3);
  }

  .hero__sello {
    display: flex;
    justify-content: center;
    padding: var(--espacio-4);
  }

  .hero__sello :global(.sello) {
    width: min(64vw, 420px);
  }

  /* Móvil: el sello sube como un pequeño timbre encima del titular,
     así el titular y los botones caben en la primera pantalla */
  @media (max-width: 879px) {
    .hero__grid {
      gap: var(--espacio-4);
    }

    .hero__sello {
      order: -1;
      justify-content: flex-start;
      padding: 0;
    }

    .hero__sello :global(.sello) {
      width: 128px;
    }
  }

  @media (max-width: 479px) {
    .hero__acciones > :global(*) {
      flex: 1 1 100%;
    }
  }

  /* Franja de datos */
  .hero__datos {
    display: grid;
    gap: var(--espacio-4);
    margin: clamp(2.5rem, 1.5rem + 3vw, 4rem) 0 0;
    padding-top: var(--espacio-5);
    border-top: 1px solid var(--borde);
  }

  /* Móvil: filas compactas, etiqueta a la izquierda y dato a la derecha */
  @media (max-width: 719px) {
    .hero__datos {
      gap: 0;
      padding-top: 0;
    }

    .hero__dato {
      display: grid;
      grid-template-columns: 88px 1fr;
      align-items: baseline;
      padding-block: var(--espacio-3);
      border-bottom: 1px solid var(--borde);
    }
  }

  @media (min-width: 720px) {
    .hero__datos {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--espacio-5);
    }

    .hero__dato + .hero__dato {
      padding-left: var(--espacio-5);
      border-left: 1px solid var(--borde);
    }
  }

  .hero__dato dt {
    color: var(--texto-suave);
    margin-bottom: var(--espacio-1);
  }

  .hero__dato dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--texto);
  }

  .hero__dato dd span {
    display: block;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  .hero__dato a {
    color: var(--texto);
    text-decoration-color: var(--oro-carta);
    text-decoration-thickness: 2px;
  }
</style>

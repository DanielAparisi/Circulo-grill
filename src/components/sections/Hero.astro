---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
---

<section class="hero-section" aria-label="Bienvenido a Círculo Grill">
  <div class="hero-bg-accent" aria-hidden="true">
    <div class="accent-circle accent-circle--1"></div>
    <div class="accent-circle accent-circle--2"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Placa del logo según el manual de marca: blanca con radio-xl y aire -->
      <div class="hero-logo-wrap" data-reveal>
        <Logo size="hero" isLink={false} />
      </div>

      <div class="hero-badge" data-reveal>
        <span class="hero-badge__dot"></span>
        <span>BAR & PARRILLA TRADICIONAL AMERICANA</span>
      </div>

      <h1 class="hero-title rotulo-xl" data-reveal>
        EL CÍRCULO GRILL <span class="hero-title__highlight">DE LAS CASTILLAS</span>
      </h1>

      <p class="hero-subtitle cuerpo" data-reveal>
        Una taberna de castillo que hace hamburguesas a la brasa, costillas glaseadas,
        tortas y entrantes caseros para compartir. Sabores auténticos en Las Castillas y Meco.
      </p>

      <div class="hero-ctas" data-reveal>
        <Button href="#carta" variant="primary" size="lg">
          <svg slot="icon-start" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
            <path d="M6 6h10"/><path d="M6 10h10"/>
          </svg>
          Ver la carta
        </Button>

        <Button href="tel:+34949327451" variant="secondary" size="lg">
          <svg slot="icon-start" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar a Las Castillas
        </Button>

        <Button
          href="https://maps.google.com/?q=El+Circulo+Grill+de+las+Castillas+Castillo+Simancas+3+Torrejon+del+Rey"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
          size="lg"
        >
          <svg slot="icon-start" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12h20"/><path d="M20 12l-4-4"/><path d="M20 12l-4 4"/>
          </svg>
          Ver exterior
        </Button>
      </div>

      <!-- Métricas y confianza rápidas -->
      <div class="hero-stats" data-reveal>
        <div class="hero-stat">
          <span class="hero-stat__value">4,5 ★</span>
          <span class="hero-stat__label">307 Reseñas Google</span>
        </div>
        <div class="hero-stat__sep" aria-hidden="true"></div>
        <div class="hero-stat">
          <span class="hero-stat__value">2 Locales</span>
          <span class="hero-stat__label">Las Castillas y Meco</span>
        </div>
        <div class="hero-stat__sep" aria-hidden="true"></div>
        <div class="hero-stat">
          <span class="hero-stat__value">Brasa & BBQ</span>
          <span class="hero-stat__label">Comida tradicional</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(2.5rem, 4vw, 4.5rem);
    padding-bottom: clamp(5rem, 8vw, 7.5rem);
    background: radial-gradient(circle at 50% 20%, #fffef7 0%, var(--crema) 70%, var(--crema-hundido) 100%);
    overflow: hidden;
    border-bottom: 1px solid var(--borde);
  }

  /* Formas orgánicas redondeadas en los márgenes según AGENTS.md 2 */
  .hero-bg-accent {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .accent-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.45;
    filter: blur(40px);
  }

  .accent-circle--1 {
    width: 380px;
    height: 380px;
    top: -100px;
    right: -80px;
    background-color: var(--melocoton);
  }

  .accent-circle--2 {
    width: 320px;
    height: 320px;
    bottom: -60px;
    left: -80px;
    background-color: var(--oro-carta);
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-logo-wrap {
    margin-bottom: var(--espacio-4);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    background-color: var(--crema-hundido);
    border: 1px solid var(--borde);
    padding: var(--espacio-1) var(--espacio-3);
    border-radius: var(--radio-pill);
    font-family: var(--font-texto);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--texto-ambar);
    margin-bottom: var(--espacio-3);
  }

  .hero-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--naranja-grill);
  }

  .hero-title {
    color: var(--texto);
    margin-bottom: var(--espacio-3);
    text-wrap: balance;
  }

  .hero-title__highlight {
    color: var(--texto-ambar);
  }

  .hero-subtitle {
    color: var(--texto-suave);
    max-width: 64ch;
    margin-bottom: var(--espacio-6);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-3);
    margin-bottom: var(--espacio-6);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--espacio-5);
    padding-top: var(--espacio-4);
    border-top: 1px solid var(--borde);
    width: 100%;
    max-width: 620px;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-stat__value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--texto);
    line-height: 1.2;
  }

  .hero-stat__label {
    font-family: var(--font-texto);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--texto-suave);
    letter-spacing: 0.5px;
  }

  .hero-stat__sep {
    width: 1px;
    height: 24px;
    background-color: var(--borde-fuerte);
  }

  @media (max-width: 640px) {
    .hero-stat__sep {
      display: none;
    }
  }
</style>

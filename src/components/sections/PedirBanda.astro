---
import { locations } from '../../data/locations';

const conReparto = locations.filter((loc) => loc.hasDelivery || loc.hasTakeAway);
---

<section class="pedir borde-almenado" id="pedir" aria-labelledby="pedir-titulo">
  <div class="container pedir__grid">
    <div class="pedir__texto" data-reveal>
      <p class="antetitulo pedir__ante">Take away · Delivery</p>
      <h2 id="pedir-titulo" class="pedir__titulo">¿Hoy cenas en casa?</h2>
      <p class="pedir__entradilla">
        Llama al local que te pille más cerca, encarga y pasa a recogerlo. O te lo llevamos.
      </p>
    </div>

    <ul class="pedir__locales" role="list">
      {conReparto.map((loc, i) => (
        <li class="pedir__local" data-reveal style={`--reveal-i: ${i + 1}`}>
          <h3 class="pedir__nombre">{loc.name}</h3>
          <p class="pedir__horario">{loc.hours.summary}</p>
          <a class="pedir__telefono" href={`tel:${loc.primaryPhone.tel}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span class="visually-hidden">Llamar a {loc.name}: </span>{loc.primaryPhone.display}
          </a>
          {loc.deliveryNote && <p class="pedir__condiciones">{loc.deliveryNote}</p>}
          {loc.orderOnlineUrl && (
            <a class="pedir__online" href={loc.orderOnlineUrl} target="_blank" rel="noopener noreferrer">
              O pídelo a domicilio en Just Eat
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pedir {
    margin-top: 16px;
    background-color: var(--parrilla);
    color: var(--texto-sobre-parrilla);
    padding-block: var(--section-y);
  }

  .pedir__grid {
    display: grid;
    gap: var(--espacio-6);
    align-items: center;
  }

  @media (min-width: 900px) {
    .pedir__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--espacio-8);
    }
  }

  .pedir__ante {
    color: var(--texto-sobre-parrilla);
    opacity: 0.8;
  }

  .pedir__titulo {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--texto-sobre-parrilla);
    margin: 0 0 var(--espacio-4);
    text-wrap: balance;
  }

  .pedir__entradilla {
    max-width: 40ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0;
  }

  .pedir__locales {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--espacio-4);
  }

  @media (min-width: 600px) {
    .pedir__locales {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pedir__local {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2);
    padding: var(--espacio-5);
    border: 1px solid rgb(255 252 241 / 0.16);
    border-radius: var(--radio-l);
    background-color: rgb(255 252 241 / 0.04);
  }

  .pedir__nombre {
    font-family: var(--font-texto);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--texto-sobre-parrilla);
    margin: 0;
  }

  .pedir__horario {
    font-size: 0.875rem;
    line-height: 1.45;
    opacity: 0.75;
    margin: 0 0 var(--espacio-2);
  }

  /* El teléfono es la acción: grande, tocable, en el oro de la marca como pastilla */
  .pedir__telefono {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-2);
    min-height: 52px;
    margin-top: auto;
    padding: var(--espacio-3) var(--espacio-5);
    border-radius: var(--radio-pill);
    background-color: var(--naranja-grill);
    color: var(--texto-sobre-oro);
    font-size: 1.1875rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.3px;
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }

  /* Resplandor de brasa: un halo que respira detrás del botón */
  .pedir__telefono::before {
    content: "";
    position: absolute;
    inset: -4px;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--naranja-grill);
    filter: blur(14px);
    opacity: 0.15;
    animation: brasa 3.4s ease-in-out infinite;
  }

  .pedir__local + .pedir__local .pedir__telefono::before {
    animation-delay: -1.7s;
  }

  @keyframes brasa {
    0%, 100% { opacity: 0.12; transform: scale(0.96); }
    50% { opacity: 0.5; transform: scale(1.03); }
  }

  .pedir__telefono svg {
    transform-origin: 50% 50%;
  }

  @media (hover: hover) {
    .pedir__telefono:hover svg {
      animation: timbre 500ms ease-in-out;
    }

    @keyframes timbre {
      0%, 100% { transform: rotate(0); }
      20%, 60% { transform: rotate(-14deg); }
      40%, 80% { transform: rotate(14deg); }
    }

    .pedir__telefono:hover {
      background-color: #cb7a07;
      color: var(--texto-sobre-oro);
    }
  }

  .pedir__telefono:focus-visible,
  .pedir__online:focus-visible {
    outline-color: var(--oro-carta);
  }

  .pedir__condiciones {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
    opacity: 0.8;
  }

  .pedir__online {
    align-self: center;
    font-size: 0.875rem;
    color: var(--texto-sobre-parrilla);
    text-decoration-color: var(--oro-carta);
    opacity: 0.85;
  }

  .pedir__online:hover {
    color: var(--texto-sobre-parrilla);
    opacity: 1;
  }
</style>

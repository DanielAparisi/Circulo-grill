---
import MenuNav from '../carta/MenuNav.astro';
import MenuCategorySection from '../carta/MenuCategorySection.astro';
import Badge from '../ui/Badge.astro';
import DeLaCasa from './DeLaCasa.astro';
import { menuCategories } from '../../data/menu';
---

<section class="carta section-padding" id="carta" aria-labelledby="carta-titulo">
  <div class="container">
    <div class="carta__hoja">
      <header class="carta__cabecera" data-reveal>
        <p class="antetitulo">Para aquí o para llevar</p>
        <h2 id="carta-titulo" class="rotulo-l">La carta</h2>
        <span class="filete filete--centro" aria-hidden="true"></span>
        <p class="carta__entradilla">El plato, qué lleva y el precio. Precios en euros, IVA incluido.</p>

        <ul class="carta__leyenda" aria-label="Qué significa cada etiqueta">
          <li><Badge variant="destacado" /> la especialidad</li>
          <li><Badge variant="vegetariano" /> sin carne ni pescado</li>
          <li><Badge variant="picante" /> pica</li>
          <li><Badge variant="novedad" /> recién llegado</li>
        </ul>
      </header>

      <DeLaCasa />

      <MenuNav categories={menuCategories} />

      <div class="carta__columnas">
        {menuCategories.map((category) => (
          <MenuCategorySection category={category} />
        ))}
      </div>

      <p class="carta__aviso">
        <strong>¿Alergias o intolerancias?</strong> Díselo a quien te atienda: tenemos la
        información de alérgenos de cada plato (Reglamento UE 1169/2011).
      </p>
    </div>
  </div>
</section>

<style>
  .carta__hoja {
    position: relative;
  }

  .carta__cabecera {
    text-align: center;
    max-width: 620px;
    margin: 0 auto var(--espacio-7);
  }

  .carta__cabecera .antetitulo {
    justify-content: center;
  }

  .carta__cabecera h2 {
    margin: 0;
  }

  .carta__entradilla {
    color: var(--texto-suave);
    margin-bottom: var(--espacio-4);
  }

  .carta__leyenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--espacio-2) var(--espacio-4);
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  /* Cada etiqueta con su explicación nunca se parte: se reparten en filas */
  .carta__leyenda li {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Columnas de periódico: las secciones tienen largos muy distintos (de 1 a 14 platos)
     y así se reparten sin dejar los huecos que dejaría una rejilla. */
  .carta__columnas :global(.menu-category-section) {
    margin-bottom: var(--espacio-7);
  }

  .carta__columnas :global(.menu-category-section:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 960px) {
    .carta__columnas {
      columns: 2;
      column-gap: var(--espacio-8);
    }

    /* Cada sección entera en una columna: Entrantes + Burgers a un lado, el resto al otro */
    .carta__columnas :global(.menu-category-section) {
      break-inside: avoid;
    }
  }

  .carta__aviso {
    max-width: 62ch;
    margin: var(--espacio-7) auto 0;
    padding-top: var(--espacio-4);
    border-top: 1px solid var(--borde);
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }

  .carta__aviso strong {
    color: var(--texto);
  }
</style>

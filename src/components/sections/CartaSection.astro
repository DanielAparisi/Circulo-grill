---
import MenuNav from '../carta/MenuNav.astro';
import MenuCategorySection from '../carta/MenuCategorySection.astro';
import Badge from '../ui/Badge.astro';
import { menuCategories } from '../../data/menu';
---

<section class="carta-section section-padding" id="carta" aria-label="Nuestra Carta">
  <div class="container">
    <div class="carta-header">
      <span class="carta-header__eyebrow etiqueta">CARTA COMPLETA</span>
      <h2 class="carta-header__title rotulo-l">NUESTRA CARTA</h2>
      <p class="carta-header__desc cuerpo">
        El plato, qué lleva y el precio. Carne de vacuno a la parrilla, raciones caseras
        y especialidades para disfrutar aquí o llevar a casa.
      </p>

      <!-- Leyenda de etiquetas -->
      <div class="carta-legend">
        <span class="carta-legend__item">
          <Badge variant="destacado" /> Especialidad de la casa
        </span>
        <span class="carta-legend__item">
          <Badge variant="vegetariano" /> Opción vegetariana
        </span>
        <span class="carta-legend__item">
          <Badge variant="picante" /> Toque picante
        </span>
        <span class="carta-legend__item">
          <Badge variant="novedad" /> Novedad en carta
        </span>
      </div>
    </div>
  </div>

  <!-- Navegación pegajosa de categorías -->
  <MenuNav categories={menuCategories} />

  <!-- Listado de categorías en dos columnas en pantallas amplias -->
  <div class="container">
    <div class="carta-grid">
      {menuCategories.map((category) => (
        <MenuCategorySection category={category} />
      ))}
    </div>

    <!-- Nota legal de alérgenos y precios (UE 1169/2011) -->
    <aside class="carta-notice" aria-label="Información de alérgenos y precios">
      <div class="carta-notice__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
      </div>
      <div class="carta-notice__text cuerpo-s">
        <p>
          <strong>Información sobre alérgenos y precios:</strong>
          Los precios indicados en la carta son en euros (€) con el IVA incluido.
          Disponemos de información detallada sobre alérgenos en todos nuestros platos
          (Reglamento UE 1169/2011). Si padeces alguna intolerancia o alergia alimentaria,
          por favor comunícaselo a nuestro personal al realizar tu pedido.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .carta-section {
    background-color: var(--crema);
  }

  .carta-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--espacio-5) auto;
  }

  .carta-header__eyebrow {
    color: var(--texto-ambar);
    display: block;
    margin-bottom: var(--espacio-1);
  }

  .carta-header__title {
    color: var(--texto);
    margin-bottom: var(--espacio-2);
  }

  .carta-header__desc {
    color: var(--texto-suave);
    margin-bottom: var(--espacio-4);
  }

  .carta-legend {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    font-family: var(--font-texto);
    font-size: 0.75rem;
    color: var(--texto-suave);
    padding: var(--espacio-2) var(--espacio-4);
    background-color: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radio-pill);
    display: inline-flex;
  }

  .carta-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Cuadrícula de la carta: 1 columna en móvil, 2 en escritorio */
  .carta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--espacio-7);
  }

  @media (min-width: 900px) {
    .carta-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--espacio-7);
      row-gap: var(--espacio-7);
    }
  }

  /* Aviso de alérgenos */
  .carta-notice {
    margin-top: var(--espacio-8);
    display: flex;
    align-items: flex-start;
    gap: var(--espacio-3);
    background-color: var(--blanco);
    border: 1px solid var(--borde);
    border-left: 4px solid var(--oro-carta);
    border-radius: var(--radio-m);
    padding: var(--espacio-4);
  }

  .carta-notice__icon {
    color: var(--texto-ambar);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .carta-notice__text p {
    margin: 0;
  }

  .carta-notice__text strong {
    color: var(--texto);
  }
</style>

---
import Button from '../ui/Button.astro';

interface Props {
  variant?: 'promo' | 'dark';
  badge?: string;
  title?: string;
  condition?: string;
  phone?: string;
  class?: string;
}

const {
  variant = 'promo',
  badge = 'TAKE AWAY & DELIVERY',
  title = '¿CENAMOS EN CASA? PÍDELO Y TE LO LLEVAMOS',
  condition = 'Servicio a domicilio en Las Castillas, Torrejón del Rey, Meco y urbanizaciones limítrofes.',
  phone = '640 529 409',
  class: className,
} = Astro.props;
---

<aside class:list={['banda-promo', `banda-promo--${variant}`, className]} aria-label="Aviso y servicio a domicilio">
  <!-- Discos orgánicos que asoman por los bordes (AGENTS.md 10.6) -->
  <div class="banda-promo__disk banda-promo__disk--1" aria-hidden="true"></div>
  <div class="banda-promo__disk banda-promo__disk--2" aria-hidden="true"></div>

  <div class="banda-promo__content">
    <span class="banda-promo__badge etiqueta">{badge}</span>
    <h2 class="banda-promo__title rotulo-l">{title}</h2>
    <p class="banda-promo__condition cuerpo">{condition}</p>

    <div class="banda-promo__footer">
      <span class="banda-promo__phone-info etiqueta">
        Pedidos telefónicos:
        <a href={`tel:+34${phone.replace(/\s+/g, '')}`} class="banda-promo__phone-link">
          {phone}
        </a>
      </span>

      <Button
        href={`tel:+34${phone.replace(/\s+/g, '')}`}
        variant={variant === 'promo' ? 'dark' : 'primary'}
        size="sm"
      >
        <svg slot="icon-start" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Llamar para pedir
      </Button>
    </div>
  </div>
</aside>

<style>
  /* BandaPromo según AGENTS.md 10.6 */
  .banda-promo {
    position: relative;
    border-radius: var(--radio-xl);
    padding: clamp(var(--espacio-5), 4vw, var(--espacio-7));
    overflow: hidden;
    margin: var(--espacio-6) auto;
    max-width: var(--container);
    box-shadow: var(--sombra-carta);
  }

  /* Variante promo: fondo naranja-destacado, tinta texto-sobre-oro */
  .banda-promo--promo {
    background-color: var(--naranja-destacado);
    color: var(--texto-sobre-oro);
  }

  .banda-promo--dark {
    background-color: var(--parrilla);
    color: var(--texto-sobre-parrilla);
  }

  /* Discos de oro-logo y melocotón por los bordes */
  .banda-promo__disk {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
  }

  .banda-promo__disk--1 {
    width: 220px;
    height: 220px;
    background-color: var(--oro-logo);
    top: -80px;
    right: -40px;
    opacity: 0.6;
  }

  .banda-promo__disk--2 {
    width: 160px;
    height: 160px;
    background-color: var(--melocoton);
    bottom: -60px;
    left: -30px;
    opacity: 0.5;
  }

  .banda-promo__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2);
    max-width: 760px;
  }

  .banda-promo__badge {
    color: var(--texto-sobre-oro);
    opacity: 0.85;
    font-weight: 800;
  }

  .banda-promo--dark .banda-promo__badge {
    color: var(--oro-logo);
    opacity: 1;
  }

  .banda-promo__title {
    color: var(--texto-sobre-oro);
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }

  .banda-promo--dark .banda-promo__title {
    color: var(--texto-sobre-parrilla);
  }

  .banda-promo__condition {
    color: var(--texto-sobre-oro);
    opacity: 0.9;
    margin: 0;
    line-height: 1.5;
  }

  .banda-promo--dark .banda-promo__condition {
    color: #e5ded4;
    opacity: 1;
  }

  .banda-promo__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--espacio-3);
    margin-top: var(--espacio-3);
    padding-top: var(--espacio-3);
    border-top: 1px solid rgba(36, 31, 27, 0.15);
  }

  .banda-promo--dark .banda-promo__footer {
    border-top: 1px solid rgba(255, 252, 241, 0.15);
  }

  .banda-promo__phone-info {
    color: var(--texto-sobre-oro);
  }

  .banda-promo--dark .banda-promo__phone-info {
    color: var(--texto-sobre-parrilla);
  }

  .banda-promo__phone-link {
    color: inherit;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: underline;
    margin-left: 4px;
  }
</style>

---
import Button from '../ui/Button.astro';
import { locations } from '../../data/locations';
---

<section class="locales section-padding" id="locales" aria-labelledby="locales-titulo">
  <div class="container">
    <header class="locales__cabecera" data-reveal>
      <p class="antetitulo">Dos casas, dos cartas, dos teléfonos</p>
      <h2 id="locales-titulo" class="rotulo-l">Dónde estamos</h2>
    </header>

    <div class="locales__grid">
      {locations.map((loc, i) => (
        <article data-reveal style={`--reveal-i: ${i}`} class="local" id={`local-${loc.id}`} aria-labelledby={`local-${loc.id}-nombre`}>
          <header class="local__cabecera">
            <span class="local__marca" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 21V8h3v2h2V8h3v2h2V8h3v2h2V8h1v13"/>
                <path d="M3 21h18"/>
                <path d="M10 21v-4a2 2 0 0 1 4 0v4"/>
              </svg>
            </span>
            <div>
              <p class="local__tipo etiqueta">{loc.badge}</p>
              <h3 id={`local-${loc.id}-nombre`} class="local__nombre">{loc.name}</h3>
            </div>
          </header>

          <dl class="local__datos">
            <div class="local__fila">
              <dt>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                Dirección
              </dt>
              <dd>
                {loc.address}<br />
                {loc.postalCode} {loc.city} ({loc.province})
              </dd>
            </div>

            <div class="local__fila">
              <dt>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                </svg>
                Horario
              </dt>
              <dd>
                <ul class="local__horas" role="list">
                  {loc.hours.details.map((d) => (
                    <li><span>{d.days}</span> <span>{d.hours}</span></li>
                  ))}
                </ul>
              </dd>
            </div>

            <div class="local__fila">
              <dt>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                Teléfono
              </dt>
              <dd class="local__telefonos">
                {loc.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}
              </dd>
            </div>
          </dl>

          <p class="local__servicios">{loc.services.join(' · ')}</p>

          <div class="local__acciones">
            <!-- Mismo texto en las dos fichas; el aria-label dice a qué local lleva cada uno -->
            <Button
              href={loc.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="secondary"
              size="md"
              aria-label={`Cómo llegar a ${loc.name} (se abre Google Maps)`}
            >
              Cómo llegar al Círculo
            </Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .locales__cabecera {
    margin-bottom: var(--espacio-6);
  }

  .locales__cabecera h2 {
    margin: 0;
  }

  .locales__grid {
    display: grid;
    gap: var(--espacio-5);
  }

  @media (min-width: 820px) {
    .locales__grid {
      grid-template-columns: repeat(2, minmax(280px, 1fr));
    }
  }

  .local {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--espacio-5);
    background-color: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radio-l);
    box-shadow: var(--sombra-carta);
  }

  @media (min-width: 720px) {
    .local {
      padding: var(--espacio-6);
    }
  }

  .local__cabecera {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
    padding-bottom: var(--espacio-4);
    margin-bottom: var(--espacio-2);
    border-bottom: 1px solid var(--borde);
  }

  .local__marca {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: var(--radio-m);
    background-color: var(--oro-logo);
    color: var(--texto-sobre-oro);
  }

  .local__tipo {
    color: var(--texto-suave);
    margin: 0 0 2px;
  }

  .local__nombre {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    margin: 0;
  }

  .local__datos {
    margin: 0;
  }

  .local__fila {
    display: grid;
    gap: var(--espacio-1);
    padding-block: var(--espacio-3);
    border-bottom: 1px solid var(--borde);
  }

  @media (min-width: 480px) {
    .local__fila {
      grid-template-columns: 120px 1fr;
      gap: var(--espacio-4);
    }
  }

  .local__fila dt {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--texto-suave);
  }

  .local__fila dt svg {
    color: var(--naranja-grill);
    flex-shrink: 0;
  }

  .local__fila dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .local__horas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .local__horas li span:first-child {
    font-weight: 600;
  }

  .local__horas li span:first-child::after {
    content: ":";
  }

  .local__telefonos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-1) var(--espacio-4);
  }

  .local__telefonos a {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    font-size: 1.0625rem;
    text-decoration: none;
    padding-block: 2px;
  }

  .local__telefonos a:hover {
    text-decoration: underline;
  }

  .local__servicios {
    margin: var(--espacio-4) 0 var(--espacio-5);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }

  .local__acciones {
    margin-top: auto;
  }

  /* El botón puede partirse en dos líneas en vez de ensanchar la tarjeta */
  .local__acciones :global(.btn) {
    width: 100%;
    white-space: normal;
    text-align: center;
  }

  @media (min-width: 480px) {
    .local__acciones :global(.btn) {
      width: auto;
    }
  }
</style>

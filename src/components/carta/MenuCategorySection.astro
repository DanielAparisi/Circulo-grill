---
import PlatoCard from './PlatoCard.astro';
import type { MenuCategory } from '../../data/menu';

interface Props {
  category: MenuCategory;
  class?: string;
}

const { category, class: className } = Astro.props;
const headingId = `cat-${category.slug}-titulo`;
---

<section
  class:list={['menu-category-section', className]}
  id={`cat-${category.slug}`}
  aria-labelledby={headingId}
>
  <header class="categoria__cabecera">
    <h3 id={headingId} class="seccion">{category.title}</h3>
    <span class="categoria__filete" aria-hidden="true"></span>
    {category.subtitle && <p class="categoria__entradilla">{category.subtitle}</p>}
  </header>

  <div class="categoria__platos">
    {category.items.map((item) => <PlatoCard item={item} />)}
  </div>
</section>

<style>
  .menu-category-section {
    scroll-margin-top: calc(var(--header-h) + 64px);
  }

  .categoria__cabecera {
    margin-bottom: var(--espacio-2);
  }

  .categoria__cabecera h3 {
    margin: 0;
  }

  /* Filete largo: punto naranja-grill + línea oro-carta a toda la columna */
  .categoria__filete {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    margin-top: var(--espacio-2);
  }

  .categoria__filete::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: var(--radio-pill);
    background-color: var(--naranja-grill);
  }

  .categoria__filete::after {
    content: "";
    flex: 1;
    height: 3px;
    border-radius: var(--radio-pill);
    background-color: var(--oro-carta);
  }

  .categoria__entradilla {
    margin: var(--espacio-2) 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--texto-suave);
  }
</style>

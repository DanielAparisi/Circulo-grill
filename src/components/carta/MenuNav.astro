---
import type { MenuCategory } from '../../data/menu';

interface Props {
  categories: MenuCategory[];
}

const { categories } = Astro.props;

const etiquetaCorta = (title: string) => {
  const primera = title.split(' ')[0];
  return primera.charAt(0) + primera.slice(1).toLowerCase();
};
---

<nav class="menu-nav" aria-label="Secciones de la carta">
  <ul class="menu-nav__lista">
    {categories.map((cat) => (
      <li>
        <a href={`#cat-${cat.slug}`} class="menu-nav__enlace" data-categoria={`cat-${cat.slug}`}>
          {etiquetaCorta(cat.title)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .menu-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    margin: 0 0 var(--espacio-6);
    background-color: rgb(255 252 241 / 0.94);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--borde);
  }

  .menu-nav__lista {
    list-style: none;
    margin: 0;
    padding: 0 var(--espacio-2);
    display: flex;
    justify-content: safe center;
    gap: var(--espacio-1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  @media (max-width: 719px) {
    .menu-nav {
      margin-inline: calc(-1 * var(--gutter));
    }

    .menu-nav__lista {
      justify-content: flex-start;
      padding-inline: calc(var(--gutter) - var(--espacio-3));
    }
  }

  .menu-nav__lista::-webkit-scrollbar {
    display: none;
  }

  .menu-nav__enlace {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--espacio-3);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--texto-suave);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  .menu-nav__enlace::after {
    content: "";
    position: absolute;
    left: var(--espacio-3);
    right: var(--espacio-3);
    bottom: -1px;
    height: 3px;
    border-radius: var(--radio-pill);
    background-color: var(--naranja-grill);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .menu-nav__enlace:hover,
  .menu-nav__enlace[aria-current="true"] {
    color: var(--texto);
  }

  .menu-nav__enlace[aria-current="true"]::after {
    transform: scaleX(1);
  }
</style>

<script>
  // Marca la sección de la carta que se está leyendo
  const enlaces = document.querySelectorAll<HTMLAnchorElement>('.menu-nav__enlace');
  const secciones = document.querySelectorAll<HTMLElement>('.menu-category-section');

  if ('IntersectionObserver' in window && secciones.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          enlaces.forEach((a) => {
            const activo = a.dataset.categoria === entry.target.id;
            a.toggleAttribute('aria-current', activo);
            if (activo) {
              a.setAttribute('aria-current', 'true');
              // Centra la pestaña activa en móvil sin mover la página
              const lista = a.closest('ul');
              lista?.scrollTo({ left: a.offsetLeft - (lista.clientWidth - a.offsetWidth) / 2 });
            }
          });
        });
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    secciones.forEach((s) => io.observe(s));
  }
</script>

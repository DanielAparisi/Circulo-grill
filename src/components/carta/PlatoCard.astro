---
import Badge from '../ui/Badge.astro';
import type { MenuItem } from '../../data/menu';

interface Props {
  item: MenuItem;
  class?: string;
}

const { item, class: className } = Astro.props;

// Máximo dos etiquetas por plato (manual 10.2)
const etiquetas = [
  item.isHouseSpecial && 'destacado',
  item.isNew && 'novedad',
  item.isVegetarian && 'vegetariano',
  item.isSpicy && 'picante',
].filter(Boolean).slice(0, 2) as ('destacado' | 'novedad' | 'vegetariano' | 'picante')[];
---

<article class:list={['plato', className]} id={`plato-${item.id}`}>
  <div class="plato__linea">
    <h4 class="plato__nombre">
      {item.name}
      {etiquetas.map((v) => <Badge variant={v} class="plato__etiqueta" />)}
    </h4>
    <span class="plato__guia" aria-hidden="true"></span>
    <p class="plato__precio">
      <span class="visually-hidden">Precio: </span>{item.price}
    </p>
  </div>

  {item.description && <p class="plato__desc">{item.description}</p>}

  {item.options && item.options.length > 0 && (
    <ul class="plato__opciones" aria-label={`Opciones de ${item.name}`}>
      {item.options.map((opt) => <li>{opt}</li>)}
    </ul>
  )}
</article>

<style>
  .plato {
    padding-block: var(--espacio-4);
    border-bottom: 1px solid var(--borde);
  }

  .plato:last-child {
    border-bottom: none;
  }

  /* Nombre, guía de puntos y precio sobre la misma línea base */
  .plato__linea {
    display: flex;
    align-items: baseline;
    gap: var(--espacio-2);
  }

  .plato__nombre {
    font-family: var(--font-texto);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--texto);
    margin: 0;
    min-width: 0;
  }

  .plato__nombre :global(.plato__etiqueta) {
    margin-left: var(--espacio-2);
    position: relative;
    top: -1px;
  }

  .plato__guia {
    flex: 1;
    min-width: var(--espacio-4);
    border-bottom: 2px dotted var(--borde-fuerte);
    transform: translateY(-4px);
  }

  .plato__precio {
    margin: 0;
    flex-shrink: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--texto-ambar);
  }

  .plato__desc {
    max-width: 46ch;
    margin: var(--espacio-1) 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--texto-suave);
  }

  .plato__opciones {
    margin: var(--espacio-2) 0 0;
    padding-left: var(--espacio-4);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
</style>
